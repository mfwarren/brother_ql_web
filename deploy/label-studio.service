[Unit]
Description=Label Studio for Brother QL
After=network.target

[Service]
Type=simple
User=matt
Group=matt
SupplementaryGroups=lp
WorkingDirectory=/opt/label-studio/current
ExecStart=/opt/label-studio/current/.venv/bin/python /opt/label-studio/current/serve.py
Environment=SERVER_HOST=0.0.0.0
Environment=SERVER_PORT=80
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
